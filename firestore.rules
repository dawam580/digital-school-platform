rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // مجموعات المدارس والتراخيص (Digital School Licensing)
    match /schools/{licenseKey} {
      // السماح لعميل المدرسة بقراءة ترخيصه للتحقق من حالة الاشتراك
      allow read: if true;
      
      // التعديل والكتابة محصورة بالسوبر أدمن ومحظورة كلياً على التطبيقات العادية
      allow write: if request.auth != null && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'khlyftadm890@gmail.com'
      );
    }

    // طلبات تجديد الاشتراك (Renewal Requests)
    match /renewals/{requestId} {
      // القراءة لجهاز المدير العام (تُدمج محلياً وتعرض في مدير التراخيص)
      allow read: if true;
      // الإنشاء مسموح للمدرسة مع تحقق من الحقول الأساسية والحالة الأولية
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.license_key is string
        && request.resource.data.school_name is string
        && request.resource.data.admin_phone is string;
      // التعديل والحذف من الكونسول فقط (قرار القبول/الرفض يتم محلياً لدى السوبر)
      allow update, delete: if false;
    }
  }
}
